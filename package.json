{
  "name": "mermaid",
  "version": "1.0.0",
  "private": true,
  "description": "Local Markdown and Mermaid editor (MD Studio)",
  "author": "MD Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && ELECTRON_DEV=1 electron .\"",
    "electron:pack": "npm run build && electron-builder --mac --dir",
    "electron:build": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@toast-ui/editor": "^3.2.2",
    "dompurify": "^3.4.2",
    "fflate": "^0.8.2",
    "markdown-it": "^14.1.1",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.6.0",
    "monaco-editor": "^0.52.2",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.9.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^4.1.5",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "studio.md.local",
    "productName": "MD Studio",
    "copyright": "Copyright © MD Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "icon": "public/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "dmg": {
      "sign": false
    }
  }
}
